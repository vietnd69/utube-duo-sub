{
  "name": "youtube-duo-sub",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension that shows dual subtitles on YouTube using YouTube's own caption style.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vietnd69/utube-duo-sub.git"
  },
  "homepage": "https://github.com/vietnd69/utube-duo-sub#readme",
